# cellar configuration — copy to .env and fill in.
# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: provider + model overrides (defaults shown).
# CELLAR_PROVIDER=direct_api        # or: bedrock
# CELLAR_MODEL_NAME=claude-sonnet-4-6
# AWS_REGION=eu-west-2              # only used when CELLAR_PROVIDER=bedrock
# CELLAR_WORKSPACE_DIR=.cellar       # local workspace/scratch directory
